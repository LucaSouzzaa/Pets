<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastrar para adoção"
            android:textColor="@color/verde_principal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preencha os dados do animal para encontrar um novo lar."
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <!-- Foto Proporcional e Centralizada -->
        <LinearLayout
            android:id="@+id/btnFotoAdocao"
            android:layout_width="155dp"
            android:layout_height="145dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_borda_tracejada"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivPreviewFotoAdocao"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/verde_principal" />

            <TextView
                android:id="@+id/tvTextoFotoAdocao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Adicionar foto"
                android:textColor="@color/verde_principal"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nome e Idade na mesma linha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome"
                    android:textColor="@color/texto_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNomeAdocao"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ex: Bolinha"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_escuro" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Idade"
                    android:textColor="@color/texto_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etIdadeAdocao"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ex: 2 anos"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_escuro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Espécie -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Espécie"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAdocaoCao"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_botao_verde"
                android:gravity="center"
                android:text="Cão"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdocaoGato"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="Gato"
                android:textColor="@color/texto_escuro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdocaoOutro"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="Outro"
                android:textColor="@color/texto_escuro"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Porte -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Porte"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPortePequeno"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_botao_verde"
                android:gravity="center"
                android:text="Pequeno"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPorteMedio"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="Médio"
                android:textColor="@color/texto_escuro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPorteGrande"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="Grande"
                android:textColor="@color/texto_escuro"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sexo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Sexo"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSexoMacho"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_botao_verde"
                android:gravity="center"
                android:text="Macho"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSexoFemea"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="Fêmea"
                android:textColor="@color/texto_escuro"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vacinação e Castração -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_pet"
            android:orientation="horizontal"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbVacinado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/verde_principal"
                android:text="Vacinado(a)"
                android:textColor="@color/texto_escuro"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbCastrado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/verde_principal"
                android:text="Castrado(a)"
                android:textColor="@color/texto_escuro"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Descrição -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Descrição"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescricaoAdocao"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="Conte sobre o temperamento e história do pet..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@color/texto_escuro" />

        <!-- Botão Cadastrar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarAdocao"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_botao_verde"
            android:text="Cadastrar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>