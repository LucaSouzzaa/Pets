<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meu Perfil"
            android:textColor="@color/verde_principal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toque na foto ou nos campos abaixo para atualizar seus dados."
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <!-- Foto de Perfil Redonda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFotoPerfil"
                android:layout_width="115dp"
                android:layout_height="115dp"
                app:cardBackgroundColor="@color/bg_foto_placeholder"
                app:cardCornerRadius="58dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvTrocarFotoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:text="Alterar foto de perfil"
                android:textColor="@color/verde_principal"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nome Completo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nome Completo"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPerfilNome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Seu nome completo"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- E-mail (Apenas leitura para identificar a conta) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="E-mail da conta"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPerfilEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_secundario" />

        <!-- Telefone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Telefone"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPerfilTelefone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="(11) 99999-9999"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- Nova Senha (Opcional) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nova Senha (opcional)"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPerfilSenha"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Deixe em branco para manter a atual"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- Botão Salvar Alterações -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarPerfil"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_botao_verde"
            android:text="Salvar alterações"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Botão Sair da Conta -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSairConta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:text="Sair da conta"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>