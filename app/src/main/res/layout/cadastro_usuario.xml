<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Cabeçalho Voltar -->
        <TextView
            android:id="@+id/tvVoltarLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="&lt;  Criar conta"
            android:textColor="@color/verde_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Foto de Perfil do Usuário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFotoUsuario"
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:cardBackgroundColor="@color/bg_foto_placeholder"
                app:cardCornerRadius="55dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivFotoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Adicionar foto de perfil"
                android:textColor="@color/verde_principal"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nome Completo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nome Completo"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCadastroNome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Digite seu nome completo"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- E-mail -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="E-mail"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCadastroEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="voce@exemplo.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- Telefone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Telefone / WhatsApp"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCadastroTelefone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="(11) 99999-9999"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- Senha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Senha"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCadastroSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Crie uma senha"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_escuro" />

        <!-- Botão CADASTRAR -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCadastrarUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_botao_verde"
            android:text="CADASTRAR"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>